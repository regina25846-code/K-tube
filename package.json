{
  "name": "kris-tube",
  "version": "1.2.0",
  "description": "K-Tube — YouTube 알고리즘 영상 분석기",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.kris.tube",
    "productName": "K-Tube",
    "asar": false,
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "regina25846-code",
      "repo": "K-tube"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "K-Tube-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
